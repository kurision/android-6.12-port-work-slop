#!/usr/bin/expect -f
# usage: rscp.exp remote-path local-path
set timeout 180
spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o PreferredAuthentications=password -o PubkeyAuthentication=no user@172.16.42.1:[lindex $argv 0] [lindex $argv 1]
expect {
    -re "(?i)password:" { send "147147\r"; exp_continue }
    eof
}
catch wait result
exit [lindex $result 3]