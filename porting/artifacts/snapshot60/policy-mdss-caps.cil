;; Harness-only mappings for the 6.12 MDP attributes; fb0/mdp is a symlink.
;; Reuse the vendor's graphics type and existing composer/mm-pp permissions.
;; Move these mappings into the device's vendor genfs_contexts before shipping.
(genfscon sysfs "/devices/platform/soc@0/1a00000.qcom,mdss_mdp/caps" (u object_r sysfs_graphics ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc@0/1a00000.qcom,mdss_mdp/bw_mode_bitmap" (u object_r sysfs_graphics ((s0) (s0))))
