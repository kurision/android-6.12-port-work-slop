;; Harness-only policy delta for tissot display bring-up (run77+).
;; The DIAG base plat policy carries no graphics genfscon, so the MDP caps
;; file lands on the generic sysfs label and the composer + mm-pp daemons
;; are denied (run73 AVCs). The product needs the equivalent rule in its
;; own policy; this delta exists only so the harness can observe past it.
;; NEVER ship; remove once the product policy covers the path.
(type sysfs_mdss_mdp_caps)
(roletype object_r sysfs_mdss_mdp_caps)
(genfscon sysfs "/devices/virtual/graphics/fb0/mdp/caps" (u object_r sysfs_mdss_mdp_caps ((s0) (s0))))
(allow hal_graphics_composer_default sysfs_mdss_mdp_caps (file (getattr open read)))
(allow mm-pp-daemon sysfs_mdss_mdp_caps (file (getattr open read)))
