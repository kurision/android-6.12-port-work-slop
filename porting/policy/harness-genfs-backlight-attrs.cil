;; MDSS lcd-backlight LED, not the raw SPMI WLED backlight object.
;; Canonical path observed in run168-test/sysfs-paths.log; label untested.
;; This genfscon prefix covers the directory and its descendants.
(genfscon sysfs "/devices/platform/soc@0/1a00000.qcom,mdss_mdp/1a00000.qcom,mdss_mdp:qcom,mdss_fb_primary/leds/lcd-backlight" (u object_r sysfs_graphics ((s0) (s0))))