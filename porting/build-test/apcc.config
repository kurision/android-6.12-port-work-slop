# Build-test fragment: MSM8953 CPU bring-up, merged on top of
# scripts/tissot-ack.config by the build wrapper (it merges exactly one
# fragment, so the two are concatenated before the build).

CONFIG_QCOM_CLK_APCC_MSM8953=y
# The APCS PLL retains its MX floor through the existing RPM power domain.
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_MSM8953_APM=y
CONFIG_QCOM_MSM8953_SPM=y
CONFIG_REGULATOR_QCOM_MSM8953_MEM_ACC=y
CONFIG_REGULATOR_QCOM_MSM8953_SPM=y
CONFIG_REGULATOR_CPR4_APSS=y
# REGULATOR_CPR4_APSS depends on REGULATOR_CPR3 rather than selecting it, so
# olddefconfig drops the CPR4 block unless the core is requested too.
CONFIG_REGULATOR_CPR3=y

# A shared policy becomes available only after the APC rail, MX domain and
# APCC handoff succeed; enabling CPUFreq alone does not establish working DVFS.
CONFIG_CPUFREQ_DT=y
