# Build-test fragment: MSM8953 CPU bring-up sources, all still unwired in DT.
#
# Merged on top of the archived run236 configuration by the build test, so the
# only difference against that kernel is these six symbols plus whatever
# olddefconfig resolves from them. Nothing here changes boot behaviour: every
# driver in this block has no DT node yet.

CONFIG_QCOM_CLK_APCC_MSM8953=y
CONFIG_QCOM_MSM8953_APM=y
CONFIG_QCOM_MSM8953_SPM=y
CONFIG_REGULATOR_QCOM_MSM8953_MEM_ACC=y
CONFIG_REGULATOR_QCOM_MSM8953_SPM=y
CONFIG_REGULATOR_CPR4_APSS=y
# REGULATOR_CPR4_APSS depends on REGULATOR_CPR3 rather than selecting it, so
# olddefconfig drops the CPR4 block unless the core is requested too.
CONFIG_REGULATOR_CPR3=y

# Drop DWARF debug info from the experiment kernel. None of these gates reads
# a symbol or a backtrace out of vmlinux, and the debug info dominates the
# image and the link time. Revert this when something needs a stack trace.
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_BTF=n